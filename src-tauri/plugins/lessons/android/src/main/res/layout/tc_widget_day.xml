        <TextView
            android:id="@+id/tc_day_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="Уроки на день"
            android:textColor="@color/tc_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tc_day_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textColor="@color/tc_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tc_day_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/tc_accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tc_day_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Откройте приложение, чтобы показать расписание"
        android:textColor="@color/tc_muted"
        android:textSize="14sp" />

