<?xml version="1.0" encoding="utf-8"?>
<!-- «Уроки на день»: до конца уроков — сегодня, потом — следующий учебный день.
     Строки заданы заранее (RemoteViews не создаёт виджеты на ходу), лишние скрываются. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tc_widget_bg"
