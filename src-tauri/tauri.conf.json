{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teacher Companion",
  "version": "0.1.0",
  "identifier": "ru.teacher-companion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Помощник учителя",
        "width": 1180,
        "height": 800,
        "minWidth": 280,
        "minHeight": 220,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
