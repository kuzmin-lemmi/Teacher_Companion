{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teacher Companion",
  "version": "../package.json",
  "identifier": "ru.teacher-companion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Помощник учителя",
        "width": 1180,
        "height": 800,
        "minWidth": 200,
        "minHeight": 100,
        "transparent": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Teacher Companion",
    "category": "Education",
    "shortDescription": "Помощник учителя — расписание на рабочем столе",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NDhDQTQ2MDZDOEUzNEMKUldSTTQ4Z0dSc3BJUmlpeVBYWFkyelpwRFgycnRvdWhWS29hNjBIL3dmVG1JL2Nwa2RDWi84TUoK",
      "endpoints": [
        "https://github.com/kuzmin-lemmi/Teacher_Companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
